rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = role flag on the actor's own users/{uid} doc
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data['role'] == 'admin';
    }

    // Shared clock probe used by TrustedTime
    match /_time/{docId} {
      allow read, write: if request.auth != null;
    }

    // User profile doc (holds the admin role flag)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // All user-owned data: customers, transactions, reminders,
    // subscription/status, meta — owner only
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin dashboard mirror: owner (trial/backfill) or admin
    match /subscriptions/{uid} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
    }
  }
}
