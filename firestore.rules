rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = safely checks if doc exists, then safely checks role
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin';
    }

    match /_time/{docId} {
      allow read, write: if request.auth != null;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /users/{uid}/{document=**} {
  allow read, write: if request.auth != null &&
    (request.auth.uid == uid || isAdmin());
}

    // Includes {document=**} in case you add subcollections later
    match /subscriptions/{uid}/{document=**} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
    }
  }
}